# Copy to .env and fill in. Never commit real keys.
# Prefer a restricted API key (rk_test_… / rk_live_…) over a full secret key.
STRIPE_SECRET_KEY=rk_test_or_sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Tax: set true only after Tax Settings head office + an active registration
# (Dashboard → Tax). Without a registration, automatic_tax collects $0 with no error.
STRIPE_AUTOMATIC_TAX=false
# Candidate product tax codes from Stripe Tax Codes API — confirm with your tax advisor.
STRIPE_TAX_CODE_SHOWER=txcd_33150006
STRIPE_TAX_CODE_REFILL=txcd_99999999
# Quarterly Autoship filter refill (USD)
STRIPE_FILTER_REFILL_AMOUNT=29

SITE_URL=http://127.0.0.1:4173/Showerhead-website
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5173,http://localhost:5173,https://belongarobert.github.io
PORT=8787
VITE_CHECKOUT_API_URL=http://127.0.0.1:8787
