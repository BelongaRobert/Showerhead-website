<div class="announcement" role="region" aria-label="Announcement">
  <p>{{ section.settings.text }}</p>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Hey there! Welcome to Drop Lab"
    }
  ]
}
{% endschema %}
