<section class="benefits">
  <div class="section-head">
    {% if section.settings.pill != blank %}
      <p class="pill">{{ section.settings.pill }}</p>
    {% endif %}
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="benefits__grid">
    <article>
      {{ 'benefit-skin.jpg' | asset_url | img_tag: 'Soothes skin', '' }}
      <h3>Soothes skin</h3>
      <p>Gentler water for a calmer, more comfortable rinse.</p>
      <strong>93%</strong>
      <span>felt less dryness in 30 days</span>
    </article>
    <article>
      {{ 'benefit-hair.jpg' | asset_url | img_tag: 'Softer hair', '' }}
      <h3>Softer hair</h3>
      <p>Helps protect moisture with less harsh chlorine exposure.</p>
      <strong>94%</strong>
      <span>saw less shedding in 30 days</span>
    </article>
    <article>
      {{ 'benefit-pressure.jpg' | asset_url | img_tag: 'Clean powerful spray', '' }}
      <h3>Clean, powerful spray</h3>
      <p>Hydro-Shield filtration with satisfying everyday pressure.</p>
      <strong>100%</strong>
      <span>reported a better shower every day</span>
    </article>
  </div>
</section>

{% schema %}
{
  "name": "Benefits",
  "settings": [
    { "type": "text", "id": "pill", "label": "Pill", "default": "A healthier you" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You’ll experience" }
  ],
  "presets": [{ "name": "Benefits" }]
}
{% endschema %}
