<section class="faq" id="faq">
  <div class="section-head">
    <p class="pill">{{ section.settings.pill }}</p>
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="faq__list">
    {% for block in section.blocks %}
      <details class="accordion" {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
        <summary>{{ block.settings.question }}</summary>
        <p>{{ block.settings.answer }}</p>
      </details>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "pill", "label": "Pill", "default": "Support" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How often do I need to replace the filter?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Dr. Droppy’s rule: swap the cartridge every 90 days." }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "How often do I need to replace the filter?",
            "answer": "Dr. Droppy’s rule: swap the cartridge every 90 days for the best performance."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Will the pressure be worse than my current showerhead?",
            "answer": "Nope. It’s built for high flow while filtration runs in parallel — most people say pressure feels the same or better."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Does the filter actually work?",
            "answer": "Yes. Our multi-stage media is tested for chlorine reduction across a 3-month lifespan."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Who is Dr. Droppy?",
            "answer": "Dr. Droppy is our friendly water expert — your cheerful reminder that cleaner shower water should feel simple, friendly, and fun."
          }
        }
      ]
    }
  ]
}
{% endschema %}
