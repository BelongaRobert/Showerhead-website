<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <p class="footer-brand">
        {{ 'mr-droppy-avatar.png' | asset_url | img_tag: '', 'footer-mascot' }}
        drop lab
      </p>
      <p>Every drop has a story. Good for you & the planet.</p>
    </div>
    <div>
      <h3>Shop</h3>
      <a href="{{ routes.all_products_collection_url }}">FLOW 01</a>
      <a href="{{ routes.cart_url }}">Cart</a>
    </div>
    <div>
      <h3>Contact</h3>
      <a href="mailto:{{ shop.email }}">{{ shop.email }}</a>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
