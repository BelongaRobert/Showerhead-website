<header class="site-header">
  {% capture shop_now_url %}{% render 'shop-now-url', product: section.settings.product %}{% endcapture %}
  {% assign shop_now_url = shop_now_url | strip %}

  <div class="site-header__left">
    <nav class="site-nav" aria-label="Primary">
      <a href="{{ shop_now_url }}">Shop</a>
      <a href="/#reviews">Reviews</a>
      <a href="/#faq">FAQ</a>
    </nav>
  </div>

  <a class="brand" href="{{ routes.root_url }}">
    {{ 'dr-droppy-avatar.png' | asset_url | img_tag: 'Dr. Droppy', 'brand__mascot' }}
    <span>Dr. Droppy.</span>
  </a>

  <div class="site-header__right">
    <a class="header-cart" href="{{ routes.cart_url }}" aria-label="Cart ({{ cart.item_count }})">Cart ({{ cart.item_count }})</a>
    <a class="btn btn--small" href="{{ shop_now_url }}">Shop now</a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Shop now product override",
      "info": "Optional. Leave blank to use Theme settings → Featured product."
    }
  ]
}
{% endschema %}
