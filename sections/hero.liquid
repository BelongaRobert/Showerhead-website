<section class="hero">
  {% capture shop_now_url %}{% render 'shop-now-url', product: section.settings.product %}{% endcapture %}
  {% assign shop_now_url = shop_now_url | strip %}

  <div class="hero__media">
    {{ 'hero-showerhead.jpg' | asset_url | img_tag: 'Dr. Droppy filtered shower head', 'hero__image' }}
    <div class="hero__badge">
      {{ 'dr-droppy-avatar.png' | asset_url | img_tag: '', 'hero__badge-img' }}
      <span>Dr. Droppy’s pick</span>
    </div>
  </div>
  <div class="hero__copy">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1>{{ section.settings.heading }}</h1>
    {% if section.settings.tagline != blank %}
      <p class="tagline">{{ section.settings.tagline }}</p>
    {% endif %}
    {% if section.settings.text != blank %}
      <p class="lede">{{ section.settings.text }}</p>
    {% endif %}
    <ul class="chips">
      <li>Removes chlorine</li>
      <li>Hydro-Shield filtration</li>
      <li>Soothes skin & hair</li>
      <li>Easy install</li>
    </ul>
    {% if section.settings.button_label != blank %}
      <a class="btn" href="{{ shop_now_url }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dr. Droppy · Clean Water" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Filtered Shower Head" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Science. Nature. Better Showers." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Science-backed purity for your family — cleaner water for healthier skin and hair."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    {
      "type": "product",
      "id": "product",
      "label": "Product override",
      "info": "Optional. Shop now goes to this product page. Leave blank to use Theme settings → Featured product."
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
