<section class="hero">
  <div class="hero__media">
    {{ 'hero-showerhead.jpg' | asset_url | img_tag: 'FLOW 01 shower head', 'hero__image' }}
    <div class="hero__badge">
      {{ 'mr-droppy-avatar.png' | asset_url | img_tag: '', 'hero__badge-img' }}
      <span>Dr. Droppy’s pick</span>
    </div>
  </div>
  <div class="hero__copy">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1>{{ section.settings.heading }}</h1>
    {% if section.settings.tagline != blank %}
      <p class="tagline">{{ section.settings.tagline }}</p>
    {% endif %}
    {% if section.settings.text != blank %}
      <p class="lede">{{ section.settings.text }}</p>
    {% endif %}
    <ul class="chips">
      <li>Better water</li>
      <li>Better skin</li>
      <li>Better hair</li>
      <li>Better you</li>
    </ul>
    {% if section.settings.button_label != blank %}
      <a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drop Lab · Filtered Shower Head" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FLOW 01" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "The shower upgrade your skin will love." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A playful, powerful multi-stage shower filter." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop FLOW 01" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
