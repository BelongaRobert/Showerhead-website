<section class="hey">
  <div class="hey__grid">
    {{ 'mr-droppy.jpg' | asset_url | img_tag: 'Mr. Droppy', 'hey__mascot' }}
    <div>
      {% if section.settings.pill != blank %}
        <p class="pill">{{ section.settings.pill }}</p>
      {% endif %}
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.lead != blank %}
        <p class="hey__lead">{{ section.settings.lead }}</p>
      {% endif %}
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hey there",
  "settings": [
    { "type": "text", "id": "pill", "label": "Pill", "default": "Unboxing vibes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hey there!" },
    { "type": "text", "id": "lead", "label": "Lead", "default": "You just made a really good choice." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every drop has a story." }
  ],
  "presets": [{ "name": "Hey there" }]
}
{% endschema %}
