<section class="hey">
  <div class="hey__grid">
    {{ 'dr-droppy-hero.png' | asset_url | img_tag: 'Dr. Droppy', 'hey__mascot' }}
    <div>
      {% if section.settings.pill != blank %}
        <p class="pill">{{ section.settings.pill }}</p>
      {% endif %}
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.lead != blank %}
        <p class="hey__lead">{{ section.settings.lead }}</p>
      {% endif %}
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hey there",
  "settings": [
    { "type": "text", "id": "pill", "label": "Pill", "default": "Meet Dr. Droppy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hello! I’m Dr. Droppy." },
    { "type": "text", "id": "lead", "label": "Lead", "default": "Your guide to cleaner shower water." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Science-backed purity for everyday showers." }
  ],
  "presets": [{ "name": "Hey there" }]
}
{% endschema %}
