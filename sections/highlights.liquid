<section class="highlights" id="highlights">
  <div class="section-head">
    {% if section.settings.pill != blank %}
      <p class="pill">{{ section.settings.pill }}</p>
    {% endif %}
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}
      <p class="section-lead">{{ section.settings.text }}</p>
    {% endif %}
  </div>

  <div class="highlights__grid">
    <article class="highlight-card">
      <span class="highlight-card__step">01</span>
      {{ 'hero-showerhead.jpg' | asset_url | img_tag: 'Removes chlorine', 'highlight-card__img' }}
      <h3>Removes chlorine</h3>
      <p>Multi-stage filtration helps strip harsh chlorine before it hits your skin and hair.</p>
    </article>
    <article class="highlight-card">
      <span class="highlight-card__step">02</span>
      {{ 'product-detail.jpg' | asset_url | img_tag: 'Hydro-Shield filtration', 'highlight-card__img' }}
      <h3>Hydro-Shield filtration</h3>
      <p>Science-backed media for cleaner water — without giving up everyday shower pressure.</p>
    </article>
    <article class="highlight-card">
      <span class="highlight-card__step">03</span>
      {{ 'gallery-1.jpg' | asset_url | img_tag: 'Easy install', 'highlight-card__img' }}
      <h3>Install in minutes</h3>
      <p>Twist on, rinse happier. No plumber required — Dr. Droppy keeps it simple.</p>
    </article>
  </div>
</section>

{% schema %}
{
  "name": "Highlights",
  "settings": [
    { "type": "text", "id": "pill", "label": "Pill", "default": "Why Dr. Droppy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cleaner water, simpler routine" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Filtration, feel, and install — condensed into what matters most."
    }
  ],
  "presets": [{ "name": "Highlights" }]
}
{% endschema %}
