<section class="cart">
  <h1>Cart</h1>
  {% if cart.item_count == 0 %}
    <p>Your cart is empty.</p>
    <a class="btn" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post">
      {% for item in cart.items %}
        <div class="cart-row">
          <div>
            <strong>{{ item.product.title }}</strong>
            <p>{{ item.final_line_price | money }}</p>
          </div>
          <input type="number" name="updates[]" value="{{ item.quantity }}" min="0">
        </div>
      {% endfor %}
      <p class="cart-total">Total: {{ cart.total_price | money }}</p>
      <button class="btn" type="submit" name="update">Update cart</button>
      <button class="btn btn--light" type="submit" name="checkout">Checkout</button>
    </form>
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
