<section class="password">
  {{ 'dr-droppy-hero.png' | asset_url | img_tag: 'Dr. Droppy', 'password__mascot' }}
  <h1>{{ shop.name }}</h1>
  <p>Dr. Droppy is almost ready. Enter the store password to peek inside.</p>
  {% form 'storefront_password' %}
    {{ form.errors | default_errors }}
    <input type="password" name="password" placeholder="Password">
    <button class="btn" type="submit">Enter</button>
  {% endform %}
</section>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
