<section class="product">
  <div class="product__grid">
    <div class="product__media">
      {% if product.featured_media %}
        {{ product.featured_media | image_url: width: 1200 | image_tag: loading: 'eager', class: 'product__image' }}
      {% else %}
        {{ 'gallery-1.jpg' | asset_url | img_tag: product.title, 'product__image' }}
      {% endif %}
    </div>
    <div class="product__info">
      <p class="eyebrow">Drop Lab</p>
      <h1>{{ product.title }}</h1>
      <p class="product__price">{{ product.selected_or_first_available_variant.price | money }}</p>
      {% if product.description != blank %}
        <div class="product__description">{{ product.description }}</div>
      {% endif %}
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button class="btn" type="submit" {% unless product.available %}disabled{% endunless %}>
          {% if product.available %}Add to cart{% else %}Sold out{% endif %}
        </button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
