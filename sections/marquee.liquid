<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {% for i in (1..2) %}
      <p>
        {{ section.settings.text }}
      </p>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Clean Water · Better Experiences · Science-Backed Purity · Dr. Droppy · Removes Chlorine · Healthier Skin · Soft Hair · Clean Water · Better Experiences ·"
    }
  ],
  "presets": [{ "name": "Marquee" }]
}
{% endschema %}
