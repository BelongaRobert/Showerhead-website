{% comment %}
  Product photo + Add to cart render from layout/theme.liquid
  (snippet pdp-purchase) so they cannot disappear when this section
  file fails to sync from GitHub.
{% endcomment %}
{% unless request.page_type == 'product' or template.name == 'product' %}
  {% capture shop_now_url %}{% render 'shop-now-url', product: section.settings.product %}{% endcapture %}
  <section class="hero" id="buy">
    <div class="hero__copy">
      <p class="eyebrow">Dr. Droppy · Clean Water</p>
      <h1>Filtered Shower Head</h1>
      <p class="tagline">Science. Nature. Better Showers.</p>
      <a class="btn" href="{{ shop_now_url | strip }}">Shop now</a>
    </div>
  </section>
{% endunless %}

{% schema %}
{
  "name": "Product buy box",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Showerhead product"
    },
    {
      "type": "product",
      "id": "filter_product",
      "label": "Carbon filter product"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Dr. Droppy · Filtered Shower Head"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Filtered Shower Head"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Science. Nature. Better Showers."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "A multi-stage filtered shower head that helps remove chlorine and harsh stuff from tap water — science-backed purity for your family."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [{ "name": "Product buy box" }]
}
{% endschema %}
