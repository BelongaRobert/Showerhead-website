{% if request.page_type == 'product' or template.name == 'product' %}
<section class="pdp" id="buy" data-section-id="{{ section.id }}">
  {%- liquid
    assign filter_product = section.settings.filter_product
    if filter_product == blank
      assign filter_product = settings.filter_subscription_product
    endif
    if filter_product == blank
      for candidate in collections.all.products
        if candidate.tags contains 'filter-refill' or candidate.tags contains 'subscription-addon' or candidate.title contains 'Carbon Showerhead Filter' or candidate.title contains 'Carbon Filter' or candidate.handle contains 'carbon-filter' or candidate.handle contains 'carbon-showerhead-filter'
          assign filter_product = candidate
          break
        endif
      endfor
    endif

    assign featured = section.settings.product
    if featured == blank
      assign featured = settings.featured_product
    endif

    assign viewing_filter_addon = false
    if request.page_type == 'product' and product
      if filter_product != blank and product.id == filter_product.id
        assign viewing_filter_addon = true
      elsif product.title contains 'Carbon Showerhead Filter' or product.title contains 'Carbon Filter' or product.tags contains 'filter-refill' or product.tags contains 'subscription-addon'
        assign viewing_filter_addon = true
        if filter_product == blank
          assign filter_product = product
        endif
      endif
    endif

    assign main_product = nil
    if viewing_filter_addon
      if featured != blank
        assign main_product = featured
      else
        for candidate in collections.all.products
          assign skip_candidate = false
          if filter_product != blank and candidate.id == filter_product.id
            assign skip_candidate = true
          endif
          assign is_filter_addon = false
          if candidate.tags contains 'filter-refill' or candidate.tags contains 'subscription-addon'
            assign is_filter_addon = true
          endif
          if candidate.handle contains 'filter-refill' or candidate.handle contains 'carbon-filter' or candidate.handle contains 'carbon-showerhead-filter'
            assign is_filter_addon = true
          endif
          if candidate.title contains 'Carbon Showerhead Filter' or candidate.title contains 'Carbon Filter'
            assign is_filter_addon = true
          endif
          if skip_candidate == false and is_filter_addon == false
            assign main_product = candidate
            break
          endif
        endfor
      endif
    elsif request.page_type == 'product' and product
      assign main_product = product
    elsif featured != blank
      assign main_product = featured
    else
      for candidate in collections.all.products
        assign is_filter_addon = false
        if filter_product != blank and candidate.id == filter_product.id
          assign is_filter_addon = true
        endif
        if candidate.tags contains 'filter-refill' or candidate.tags contains 'subscription-addon'
          assign is_filter_addon = true
        endif
        if candidate.handle contains 'filter-refill' or candidate.handle contains 'carbon-filter' or candidate.handle contains 'carbon-showerhead-filter'
          assign is_filter_addon = true
        endif
        if candidate.title contains 'Carbon Showerhead Filter' or candidate.title contains 'Carbon Filter'
          assign is_filter_addon = true
        endif
        unless is_filter_addon
          assign main_product = candidate
          break
        endunless
      endfor
    endif

    if main_product == blank
      assign main_product = collections.all.products.first
    endif

    assign product = main_product
    assign filter_has_plans = false
    if filter_product != blank and filter_product.selling_plan_groups.size > 0
      assign filter_has_plans = true
    endif
  -%}

  {% if viewing_filter_addon and main_product != blank and filter_product != blank and main_product.id != filter_product.id %}
    <p class="pdp__switch-note">
      Carbon filters subscribe from the showerhead buy box —
      <a href="{{ main_product.url }}">open {{ main_product.title }}</a>
    </p>
    <script>
      (function () {
        var target = {{ main_product.url | json }};
        if (target && window.location.pathname !== target.split('?')[0]) {
          window.location.replace(target);
        }
      })();
    </script>
  {% endif %}

  <div class="pdp__banner" id="PdpMain-{{ section.id }}">
    <div class="pdp__badge">
      {{ 'dr-droppy-avatar.png' | asset_url | img_tag: '', 'pdp__badge-img' }}
      <span>Dr. Droppy’s pick</span>
    </div>
    {% if product != blank and product.media.size > 0 and viewing_filter_addon == false %}
      {% for media in product.media limit: 5 %}
        <img
          class="pdp__slide{% if forloop.first %} is-active{% endif %}"
          src="{{ media | image_url: width: 2000 }}"
          alt="{{ media.alt | escape | default: product.title }}"
          data-index="{{ forloop.index0 }}"
          {% unless forloop.first %}hidden{% endunless %}
        >
      {% endfor %}
    {% else %}
      {{ 'hero-showerhead.jpg' | asset_url | img_tag: 'Dr. Droppy filtered shower head', 'pdp__slide is-active' }}
      {{ 'gallery-1.jpg' | asset_url | img_tag: 'Filtered shower head spray', 'pdp__slide' }}
      {{ 'gallery-2.jpg' | asset_url | img_tag: 'Filtered shower head product', 'pdp__slide' }}
      {{ 'product-detail.jpg' | asset_url | img_tag: 'Shower head face detail', 'pdp__slide' }}
    {% endif %}
    <button type="button" class="pdp__arrow prev" data-pdp-prev aria-label="Previous image">‹</button>
    <button type="button" class="pdp__arrow next" data-pdp-next aria-label="Next image">›</button>
  </div>

  <div class="pdp__thumbs" data-pdp-thumbs>
    {% if product != blank and product.media.size > 0 and viewing_filter_addon == false %}
      {% for media in product.media limit: 5 %}
        <button type="button" class="pdp__thumb{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}">
          {{ media | image_url: width: 200 | image_tag: alt: '' }}
        </button>
      {% endfor %}
    {% else %}
      <button type="button" class="pdp__thumb is-active" data-index="0">{{ 'hero-showerhead.jpg' | asset_url | img_tag: '', '' }}</button>
      <button type="button" class="pdp__thumb" data-index="1">{{ 'gallery-1.jpg' | asset_url | img_tag: '', '' }}</button>
      <button type="button" class="pdp__thumb" data-index="2">{{ 'gallery-2.jpg' | asset_url | img_tag: '', '' }}</button>
      <button type="button" class="pdp__thumb" data-index="3">{{ 'product-detail.jpg' | asset_url | img_tag: '', '' }}</button>
    {% endif %}
  </div>

  <div class="pdp__buybox">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>
        {% if section.settings.heading != blank %}
          {{ section.settings.heading }}
        {% else %}
          Filtered Shower Head
        {% endif %}
      </h1>
      <p class="tagline">{{ section.settings.tagline }}</p>
      <p class="lede">{{ section.settings.text }}</p>

      <div class="rating-row">
        <span class="stars" aria-label="4.9 out of 5">★★★★★</span>
        <span>4.9</span>
        <a href="#reviews">128 Reviews</a>
      </div>

      <ul class="chips">
        <li>Removes chlorine</li>
        <li>Hydro-Shield filtration</li>
        <li>Soothes skin & hair</li>
        <li>Sustainable design</li>
      </ul>

      {% if product != blank %}
        {% form 'product', product, class: 'pdp__form' %}
          {% if product.variants.size > 1 %}
            <fieldset class="option-block">
              <legend>Select option</legend>
              <div class="qty-options">
                {% for variant in product.variants %}
                  <label class="qty-card{% if variant == product.selected_or_first_available_variant %} is-selected{% endif %}">
                    <input
                      type="radio"
                      name="id"
                      value="{{ variant.id }}"
                      {% if variant == product.selected_or_first_available_variant %}checked{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                    >
                    <div>
                      <strong>{{ variant.title }}</strong>
                      <span class="price-line"><em>{{ variant.price | money }}</em></span>
                    </div>
                  </label>
                {% endfor %}
              </div>
            </fieldset>
          {% else %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% endif %}

          <div class="plan-card is-selected" data-main-plan>
            <div class="popular-tag">DR. DROPPY’S FAVORITE</div>
            <div class="plan-top">
              <strong>{% if product != blank %}{{ product.title }}{% else %}Filtered Shower Head{% endif %}</strong>
              <span><em>{% if product != blank %}{{ product.selected_or_first_available_variant.price | money }}{% else %}$129{% endif %}</em></span>
            </div>
            <ul>
              <li>Filtered shower head + install kit</li>
              <li>Built for clearer skin & stronger hair</li>
              <li>60-day money-back guarantee</li>
            </ul>
          </div>

          {%- liquid
            assign filter_title = section.settings.filter_title | default: 'Carbon Showerhead Filters'
            assign filter_price_label = section.settings.filter_price_label | default: '$29.99'
            assign filter_variant_id = section.settings.filter_variant_id | strip
            assign head_price = product.selected_or_first_available_variant.price
            assign compare_price = section.settings.autoship_compare_price | default: '$199'
            assign autoship_price = section.settings.autoship_price | default: ''
            if autoship_price == blank and product != blank
              assign autoship_price = head_price | money
            elsif autoship_price == blank
              assign autoship_price = '$129'
            endif
            assign save_badge = section.settings.autoship_save_badge | default: 'SAVE $70'
            if filter_product != blank
              assign filter_title = filter_product.title
              assign filter_price_label = filter_product.selected_or_first_available_variant.price | money
              if filter_variant_id == blank
                assign filter_variant_id = filter_product.selected_or_first_available_variant.id
              endif
            endif
            assign filter_img_1 = section.settings.filter_image_1
            assign filter_img_2 = section.settings.filter_image_2
            assign filter_img_3 = section.settings.filter_image_3
            assign first_plan_id = ''
            if filter_has_plans
              assign first_plan_id = filter_product.selling_plan_groups.first.selling_plans.first.id
            endif
          -%}

          <div
            class="filter-addon is-visible"
            data-filter-addon
            data-filter-variant-id="{{ filter_variant_id }}"
            data-filter-available="{% if filter_product == blank or filter_product.available %}true{% else %}false{% endif %}"
          >
            <div class="filter-addon__gallery" data-filter-gallery>
              {% if filter_img_1 != blank %}
                <img class="filter-addon__slide is-active" src="{{ filter_img_1 | image_url: width: 900 }}" alt="{{ filter_title | escape }}" data-index="0">
              {% else %}
                <img class="filter-addon__slide is-active" src="{{ 'filter-1.jpg' | asset_url }}" alt="{{ filter_title | escape }}" data-index="0">
              {% endif %}
              {% if filter_img_2 != blank %}
                <img class="filter-addon__slide" src="{{ filter_img_2 | image_url: width: 900 }}" alt="{{ filter_title | escape }}" data-index="1" hidden>
              {% else %}
                <img class="filter-addon__slide" src="{{ 'filter-2.jpg' | asset_url }}" alt="{{ filter_title | escape }}" data-index="1" hidden>
              {% endif %}
              {% if filter_img_3 != blank %}
                <img class="filter-addon__slide" src="{{ filter_img_3 | image_url: width: 900 }}" alt="{{ filter_title | escape }}" data-index="2" hidden>
              {% else %}
                <img class="filter-addon__slide" src="{{ 'filter-3.jpg' | asset_url }}" alt="{{ filter_title | escape }}" data-index="2" hidden>
              {% endif %}
            </div>
            <div class="filter-addon__thumbs" data-filter-thumbs>
              <button type="button" class="filter-addon__thumb is-active" data-index="0" aria-label="Filter photo 1">
                {% if filter_img_1 != blank %}
                  {{ filter_img_1 | image_url: width: 200 | image_tag: alt: '' }}
                {% else %}
                  {{ 'filter-1.jpg' | asset_url | img_tag: '', '' }}
                {% endif %}
              </button>
              <button type="button" class="filter-addon__thumb" data-index="1" aria-label="Filter photo 2">
                {% if filter_img_2 != blank %}
                  {{ filter_img_2 | image_url: width: 200 | image_tag: alt: '' }}
                {% else %}
                  {{ 'filter-2.jpg' | asset_url | img_tag: '', '' }}
                {% endif %}
              </button>
              <button type="button" class="filter-addon__thumb" data-index="2" aria-label="Filter photo 3">
                {% if filter_img_3 != blank %}
                  {{ filter_img_3 | image_url: width: 200 | image_tag: alt: '' }}
                {% else %}
                  {{ 'filter-3.jpg' | asset_url | img_tag: '', '' }}
                {% endif %}
              </button>
            </div>

            <fieldset class="sub-box" data-purchase-modes>
              <legend class="sub-box__label">Subscription</legend>

              <label class="sub-card sub-card--autoship is-selected">
                <input type="radio" name="purchase_mode" value="subscribe" checked>
                <span class="sub-card__save">{{ save_badge }}</span>
                <span class="sub-card__top">
                  <span class="sub-card__choice">
                    <span class="sub-card__radio" aria-hidden="true"></span>
                    <strong class="sub-card__title">Autoship</strong>
                  </span>
                  <span class="sub-card__pricing">
                    <em>{{ autoship_price }}</em>
                    <s>{{ compare_price }}</s>
                  </span>
                </span>
                <ul class="sub-card__perks">
                  <li>Showerhead + Filter + Filter Subscription</li>
                  <li>Filter shipped every 90 days ({{ filter_price_label }})</li>
                  <li>Delivery during sellouts</li>
                  <li>Pause or cancel anytime</li>
                </ul>
                <span class="sub-card__popular">Most popular option</span>
                {% if filter_has_plans %}
                  <span class="visually-hidden" data-filter-plans>
                    {% for group in filter_product.selling_plan_groups %}
                      {% for plan in group.selling_plans %}
                        <input
                          type="radio"
                          name="filter_selling_plan"
                          value="{{ plan.id }}"
                          {% if forloop.parentloop.first and forloop.first %}checked{% endif %}
                        >
                      {% endfor %}
                    {% endfor %}
                  </span>
                {% else %}
                  <input type="hidden" name="filter_selling_plan" value="{{ first_plan_id }}" data-plan-placeholder>
                {% endif %}
              </label>

              <label class="sub-card sub-card--onetime">
                <input type="radio" name="purchase_mode" value="onetime">
                <span class="sub-card__top sub-card__top--simple">
                  <span class="sub-card__choice">
                    <span class="sub-card__radio" aria-hidden="true"></span>
                    <strong class="sub-card__title">One-Time Purchase</strong>
                  </span>
                </span>
              </label>
            </fieldset>
            <p class="sub-box__note">*Price automatically updates in cart</p>
          </div>

          {%- comment -%} App blocks (Loop Subscribe & Save widget, etc.) {%- endcomment -%}
          <div class="pdp__apps" data-loop-slot>
            {% for block in section.blocks %}
              {% case block.type %}
                {% when '@app' %}
                  <div class="pdp__app-block" {{ block.shopify_attributes }}>
                    {% render block %}
                  </div>
              {% endcase %}
            {% endfor %}
          </div>

          <button class="btn btn--block" type="submit" data-atc-button {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}
              <span data-atc-label-subscribe>Add Autoship — {{ autoship_price }}</span>
              <span data-atc-label-onetime hidden>Add to cart — {{ product.selected_or_first_available_variant.price | money }}</span>
            {% else %}
              Sold out
            {% endif %}
          </button>
        {% endform %}
      {% else %}
        <div class="plan-card is-selected">
          <div class="popular-tag">DR. DROPPY’S FAVORITE</div>
          <div class="plan-top">
            <strong>Filtered Shower Head</strong>
            <span><em>$129</em></span>
          </div>
          <ul>
            <li>Filtered shower head + install kit</li>
            <li>Built for clearer skin & stronger hair</li>
            <li>60-day money-back guarantee</li>
          </ul>
        </div>

        <div class="filter-addon is-visible" data-filter-addon data-filter-variant-id="" data-filter-available="false">
          <div class="filter-addon__gallery" data-filter-gallery>
            <img class="filter-addon__slide is-active" src="{{ 'filter-1.jpg' | asset_url }}" alt="Carbon Showerhead Filters" data-index="0">
            <img class="filter-addon__slide" src="{{ 'filter-2.jpg' | asset_url }}" alt="Carbon Showerhead Filters" data-index="1" hidden>
            <img class="filter-addon__slide" src="{{ 'filter-3.jpg' | asset_url }}" alt="Carbon Showerhead Filters" data-index="2" hidden>
          </div>
          <div class="filter-addon__thumbs" data-filter-thumbs>
            <button type="button" class="filter-addon__thumb is-active" data-index="0">{{ 'filter-1.jpg' | asset_url | img_tag: '', '' }}</button>
            <button type="button" class="filter-addon__thumb" data-index="1">{{ 'filter-2.jpg' | asset_url | img_tag: '', '' }}</button>
            <button type="button" class="filter-addon__thumb" data-index="2">{{ 'filter-3.jpg' | asset_url | img_tag: '', '' }}</button>
          </div>
          <fieldset class="sub-box" data-purchase-modes>
            <legend class="sub-box__label">Subscription</legend>
            <label class="sub-card sub-card--autoship is-selected">
              <input type="radio" name="purchase_mode" value="subscribe" checked>
              <span class="sub-card__save">SAVE $70</span>
              <span class="sub-card__top">
                <span class="sub-card__choice">
                  <span class="sub-card__radio" aria-hidden="true"></span>
                  <strong class="sub-card__title">Autoship</strong>
                </span>
                <span class="sub-card__pricing"><em>$129</em><s>$199</s></span>
              </span>
              <ul class="sub-card__perks">
                <li>Showerhead + Filter + Filter Subscription</li>
                <li>Filter shipped every 90 days ($29.99)</li>
                <li>Delivery during sellouts</li>
                <li>Pause or cancel anytime</li>
              </ul>
              <span class="sub-card__popular">Most popular option</span>
            </label>
            <label class="sub-card sub-card--onetime">
              <input type="radio" name="purchase_mode" value="onetime">
              <span class="sub-card__top sub-card__top--simple">
                <span class="sub-card__choice">
                  <span class="sub-card__radio" aria-hidden="true"></span>
                  <strong class="sub-card__title">One-Time Purchase</strong>
                </span>
              </span>
            </label>
          </fieldset>
          <p class="sub-box__note">*Price automatically updates in cart</p>
        </div>

        <div class="pdp__apps">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when '@app' %}
                <div class="pdp__app-block" {{ block.shopify_attributes }}>
                  {% render block %}
                </div>
            {% endcase %}
          {% endfor %}
        </div>

        <a class="btn btn--block" href="{{ routes.all_products_collection_url }}">Shop products</a>
      {% endif %}

      <div class="trust-stack">
        <div class="stock-row">
          <span class="in-stock">In stock</span>
          <span>Ships fast</span>
        </div>
        <div class="urgency"><div class="urgency-bar" style="width:84%"></div></div>
        <p class="urgency-copy">84% of the current batch reserved · Dr. Droppy says don’t wait</p>
        <ul class="perk-list">
          <li>Chlorine-tested filter</li>
          <li>60-day money-back guarantee</li>
          <li>Good for you & the planet</li>
        </ul>
      </div>

      <aside class="droppy-tip">
        {{ 'dr-droppy-wave.png' | asset_url | img_tag: 'Dr. Droppy waving', '' }}
        <div>
          <strong>Tip from Dr. Droppy</strong>
          <p>Replace the filter every 90 days — Autoship keeps Carbon Filters coming automatically.</p>
        </div>
      </aside>

      <div class="info-accordions">
        <details class="accordion" open>
          <summary>Overview</summary>
          <ul>
            <li>Multi-stage filtration for everyday shower water</li>
            <li>High-flow pressure with wide-face coverage</li>
            <li>Universal quick install on standard shower arms</li>
          </ul>
        </details>
        <details class="accordion">
          <summary>What's Included</summary>
          <ul>
            <li>Dr. Droppy Filtered Shower Head</li>
            <li>Pre-installed filter cartridge</li>
            <li>Plumber’s tape + fit wrench</li>
            <li>A hello from Dr. Droppy</li>
          </ul>
        </details>
        <details class="accordion">
          <summary>Product Design & Performance</summary>
          <ul>
            <li>Replace filter every 90 days</li>
            <li>KDF-55 + calcium sulfite multi-stage media</li>
            <li>Targets chlorine and common shower contaminants</li>
          </ul>
        </details>
      </div>
  </div>
</section>
{% else %}
  {% comment %} Never render the product buy box on the homepage or other templates. {% endcomment %}
  {% capture shop_now_url %}{% render 'shop-now-url', product: section.settings.product %}{% endcapture %}
  <section class="hero" id="buy">
    <div class="hero__media">
      {{ 'hero-showerhead.jpg' | asset_url | img_tag: 'Dr. Droppy filtered shower head', 'hero__image' }}
    </div>
    <div class="hero__copy">
      <p class="eyebrow">Dr. Droppy · Clean Water</p>
      <h1>Filtered Shower Head</h1>
      <p class="tagline">Science. Nature. Better Showers.</p>
      <a class="btn" href="{{ shop_now_url | strip }}">Shop now</a>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Product buy box",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Featured showerhead product",
      "info": "Optional. Leave blank to use the product page product."
    },
    {
      "type": "product",
      "id": "filter_product",
      "label": "Carbon filter product (optional)",
      "info": "Only needed for live Subscribe checkout. Filters still show with built-in photos if this is empty."
    },
    {
      "type": "text",
      "id": "filter_variant_id",
      "label": "Filter variant ID (optional)",
      "info": "Paste from Shopify Admin → Carbon Filters → Variants if the product picker is empty. Numbers only."
    },
    {
      "type": "text",
      "id": "filter_title",
      "label": "Filter title",
      "default": "Carbon Showerhead Filters"
    },
    {
      "type": "text",
      "id": "filter_price_label",
      "label": "Filter price label",
      "default": "$29.99"
    },
    {
      "type": "text",
      "id": "autoship_price",
      "label": "Autoship price",
      "info": "Leave blank to use the showerhead product price.",
      "default": ""
    },
    {
      "type": "text",
      "id": "autoship_compare_price",
      "label": "Autoship compare-at price",
      "default": "$199"
    },
    {
      "type": "text",
      "id": "autoship_save_badge",
      "label": "Autoship save badge",
      "default": "SAVE $70"
    },
    {
      "type": "image_picker",
      "id": "filter_image_1",
      "label": "Filter photo 1 (optional override)"
    },
    {
      "type": "image_picker",
      "id": "filter_image_2",
      "label": "Filter photo 2 (optional override)"
    },
    {
      "type": "image_picker",
      "id": "filter_image_3",
      "label": "Filter photo 3 (optional override)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Dr. Droppy · Filtered Shower Head"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Filtered Shower Head"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "The shower upgrade your skin will love."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "A premium multi-stage shower filter that helps remove chlorine and harsh stuff from tap water — for healthier hair and skin. Guided by Dr. Droppy."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [{ "name": "Product buy box" }]
}
{% endschema %}
