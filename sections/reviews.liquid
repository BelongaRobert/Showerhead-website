<section class="reviews" id="reviews">
  <div class="section-head">
    <p class="pill">{{ section.settings.pill }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <div class="rating-row center">
      <span class="stars">★★★★★</span>
      <span>4.9 · 128 Reviews</span>
    </div>
  </div>
  <div class="review-grid">
    {% for block in section.blocks %}
      <article class="review-card" {{ block.shopify_attributes }}>
        <span class="stars">★★★★★</span>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.body }}</p>
        <footer>
          <strong>{{ block.settings.name }}</strong>
          <span>{{ block.settings.date }}</span>
        </footer>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "pill", "label": "Pill", "default": "Testimonials" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real lives changed" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Noticeably softer water" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "My skin stopped feeling tight after every shower within the first week." },
        { "type": "text", "id": "name", "label": "Name", "default": "Sophia R." },
        { "type": "text", "id": "date", "label": "Date", "default": "Aug 2, 2026" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "title": "Noticeably softer water",
            "body": "My skin stopped feeling tight after every shower within the first week. Pressure is still strong — and Dr. Droppy on the box made my kids smile.",
            "name": "Sophia R.",
            "date": "Aug 2, 2026"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Easy install, real difference",
            "body": "Twisted on in under five minutes. Hair feels less brittle. Drop Lab nailed the unboxing.",
            "name": "Marcus T.",
            "date": "Jul 28, 2026"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Worth the switch",
            "body": "FLOW 01 keeps flow high while cutting the chlorine smell. Dr. Droppy approved.",
            "name": "Elena K.",
            "date": "Jul 19, 2026"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Great for hard water",
            "body": "After a month my scalp irritation calmed down and soap rinses cleaner.",
            "name": "Jordan P.",
            "date": "Jul 11, 2026"
          }
        }
      ]
    }
  ]
}
{% endschema %}
