<section class="science" id="science">
  <div class="section-head">
    <p class="pill">{{ section.settings.pill }}</p>
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="science__grid">
    {% for block in section.blocks %}
      <article {{ block.shopify_attributes }}>
        <strong>{{ block.settings.value }}</strong>
        <p>{{ block.settings.text }}</p>
      </article>
    {% endfor %}
  </div>
  {% if section.settings.button_label != blank %}
    <a class="btn btn--center" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
  {% endif %}
</section>

{% schema %}
{
  "name": "Science stats",
  "settings": [
    { "type": "text", "id": "pill", "label": "Pill", "default": "Tested & proven" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best-in-class filtration" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to cart" },
    { "type": "url", "id": "button_link", "label": "Button link", "default": "/#buy" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "85%" },
        { "type": "text", "id": "text", "label": "Text", "default": "avg chlorine reduction across the filter’s 3-month lifespan" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Science stats",
      "blocks": [
        { "type": "stat", "settings": { "value": "85%", "text": "avg chlorine reduction across the filter’s 3-month lifespan" } },
        { "type": "stat", "settings": { "value": "75%", "text": "avg chlorine reduction after 10,000 gallons of water" } },
        { "type": "stat", "settings": { "value": "15", "text": "filtration stages packed into every filter cartridge" } },
        { "type": "stat", "settings": { "value": "250g+", "text": "calcium sulfite & KDF-55 filtration media" } }
      ]
    }
  ]
}
{% endschema %}
