<section class="social-proof" id="reviews">
  <div class="section-head">
    {% if section.settings.pill != blank %}
      <p class="pill">{{ section.settings.pill }}</p>
    {% endif %}
    <h2>{{ section.settings.heading }}</h2>
    <div class="rating-row center">
      <span class="stars">★★★★★</span>
      <span>{{ section.settings.rating_label }}</span>
    </div>
  </div>

  <div class="social-grid">
    {% for block in section.blocks %}
      <article class="ig-card" {{ block.shopify_attributes }}>
        <header class="ig-card__head">
          {% if block.settings.avatar != blank %}
            {{ block.settings.avatar | image_url: width: 120 | image_tag: class: 'ig-card__avatar', alt: block.settings.name }}
          {% elsif block.settings.avatar_asset != blank %}
            {{ block.settings.avatar_asset | asset_url | img_tag: block.settings.name, 'ig-card__avatar' }}
          {% else %}
            <span class="ig-card__avatar ig-card__avatar--fallback">{{ block.settings.name | slice: 0 }}</span>
          {% endif %}
          <div class="ig-card__meta">
            <strong>{{ block.settings.handle | default: block.settings.name }}</strong>
            <span>{{ block.settings.location | default: 'Verified buyer' }}</span>
          </div>
          <span class="ig-card__platform" aria-hidden="true">●●●</span>
        </header>

        <div class="ig-card__media">
          {% if block.settings.photo != blank %}
            {{ block.settings.photo | image_url: width: 900 | image_tag: alt: block.settings.title, loading: 'lazy' }}
          {% elsif block.settings.photo_asset != blank %}
            {{ block.settings.photo_asset | asset_url | img_tag: block.settings.title, '' }}
          {% else %}
            {{ 'hero-showerhead.jpg' | asset_url | img_tag: block.settings.title, '' }}
          {% endif %}
        </div>

        <div class="ig-card__body">
          <div class="ig-card__actions" aria-hidden="true">
            <span>♡</span><span>💬</span><span>➤</span>
          </div>
          <p class="ig-card__likes">{{ block.settings.likes | default: '2,418 likes' }}</p>
          <p class="ig-card__caption">
            <strong>{{ block.settings.handle | default: block.settings.name }}</strong>
            {{ block.settings.body }}
          </p>
          <p class="ig-card__time">{{ block.settings.date }}</p>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Social reviews",
  "settings": [
    { "type": "text", "id": "pill", "label": "Pill", "default": "Social proof" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real showers. Real reviews." },
    { "type": "text", "id": "rating_label", "label": "Rating label", "default": "4.9 · 128 Reviews" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Social post",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Sophia R." },
        { "type": "text", "id": "handle", "label": "Handle", "default": "@sophia.rinses" },
        { "type": "text", "id": "location", "label": "Subline", "default": "Austin, TX" },
        { "type": "text", "id": "title", "label": "Photo alt", "default": "Customer shower photo" },
        { "type": "textarea", "id": "body", "label": "Caption", "default": "Skin finally stopped feeling tight after showers. Pressure is still strong too 💧" },
        { "type": "text", "id": "likes", "label": "Likes line", "default": "2,418 likes" },
        { "type": "text", "id": "date", "label": "Time label", "default": "2 DAYS AGO" },
        { "type": "text", "id": "avatar_asset", "label": "Avatar asset filename", "default": "avatar-sophia.jpg" },
        { "type": "text", "id": "photo_asset", "label": "Photo asset filename", "default": "ugc-sophia.jpg" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar image (optional)" },
        { "type": "image_picker", "id": "photo", "label": "Post photo (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social reviews",
      "blocks": [
        {
          "type": "post",
          "settings": {
            "name": "Sophia R.",
            "handle": "@sophia.rinses",
            "location": "Austin, TX",
            "body": "Skin finally stopped feeling tight after showers. Pressure is still strong — and Dr. Droppy on the box made my kids smile 💧",
            "likes": "3,102 likes",
            "date": "2 DAYS AGO",
            "avatar_asset": "avatar-sophia.jpg",
            "photo_asset": "ugc-sophia.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
