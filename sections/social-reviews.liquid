<section class="social-proof" id="reviews">
  <div class="section-head">
    <p class="pill">{{ section.settings.pill | default: 'Social proof' }}</p>
    <h2>{{ section.settings.heading | default: 'Real showers. Real reviews.' }}</h2>
    <div class="rating-row center">
      <span class="stars">★★★★★</span>
      <span>{{ section.settings.rating_label | default: '4.9 · 128 Reviews' }}</span>
    </div>
  </div>

  <div class="social-grid">
    <article class="ig-card">
      <header class="ig-card__head">
        {{ 'avatar-sophia.jpg' | asset_url | img_tag: 'Sophia Ramirez', 'ig-card__avatar' }}
        <div class="ig-card__meta">
          <strong>@sophia.ramirez</strong>
          <span>Austin, TX</span>
        </div>
        <span class="ig-card__platform" aria-hidden="true">●●●</span>
      </header>
      <div class="ig-card__media">
        {{ 'ugc-sophia.jpg' | asset_url | img_tag: 'Customer holding Dr. Droppy shower head', '' }}
      </div>
      <div class="ig-card__body">
        <div class="ig-card__actions" aria-hidden="true"><span>♡</span><span>💬</span><span>➤</span></div>
        <p class="ig-card__likes">3,102 likes</p>
        <p class="ig-card__caption">
          <strong>@sophia.ramirez</strong>
          Skin finally stopped feeling tight after showers. Pressure is still strong — and Dr. Droppy on the box made my kids smile.
        </p>
        <p class="ig-card__time">2 DAYS AGO</p>
      </div>
    </article>

    <article class="ig-card">
      <header class="ig-card__head">
        {{ 'avatar-marcus.jpg' | asset_url | img_tag: 'Marcus Turner', 'ig-card__avatar' }}
        <div class="ig-card__meta">
          <strong>@marcusturner</strong>
          <span>Denver, CO</span>
        </div>
        <span class="ig-card__platform" aria-hidden="true">●●●</span>
      </header>
      <div class="ig-card__media">
        {{ 'ugc-marcus.jpg' | asset_url | img_tag: 'Installing Dr. Droppy shower head', '' }}
      </div>
      <div class="ig-card__body">
        <div class="ig-card__actions" aria-hidden="true"><span>♡</span><span>💬</span><span>➤</span></div>
        <p class="ig-card__likes">1,884 likes</p>
        <p class="ig-card__caption">
          <strong>@marcusturner</strong>
          Twisted on in under five minutes. Hair feels less brittle already. Unboxing was actually fun.
        </p>
        <p class="ig-card__time">5 DAYS AGO</p>
      </div>
    </article>

    <article class="ig-card">
      <header class="ig-card__head">
        {{ 'avatar-elena.jpg' | asset_url | img_tag: 'Elena Kim', 'ig-card__avatar' }}
        <div class="ig-card__meta">
          <strong>@elena.kim</strong>
          <span>Miami, FL</span>
        </div>
        <span class="ig-card__platform" aria-hidden="true">●●●</span>
      </header>
      <div class="ig-card__media">
        {{ 'ugc-elena.jpg' | asset_url | img_tag: 'Dr. Droppy shower head installed', '' }}
      </div>
      <div class="ig-card__body">
        <div class="ig-card__actions" aria-hidden="true"><span>♡</span><span>💬</span><span>➤</span></div>
        <p class="ig-card__likes">4,291 likes</p>
        <p class="ig-card__caption">
          <strong>@elena.kim</strong>
          Chlorine smell is gone and my hair feels softer. This is my forever shower upgrade.
        </p>
        <p class="ig-card__time">1 WEEK AGO</p>
      </div>
    </article>

    <article class="ig-card">
      <header class="ig-card__head">
        {{ 'avatar-jordan.jpg' | asset_url | img_tag: 'Jordan Park', 'ig-card__avatar' }}
        <div class="ig-card__meta">
          <strong>@jordan.park</strong>
          <span>Seattle, WA</span>
        </div>
        <span class="ig-card__platform" aria-hidden="true">●●●</span>
      </header>
      <div class="ig-card__media">
        {{ 'ugc-jordan.jpg' | asset_url | img_tag: 'Customer with Dr. Droppy shower head', '' }}
      </div>
      <div class="ig-card__body">
        <div class="ig-card__actions" aria-hidden="true"><span>♡</span><span>💬</span><span>➤</span></div>
        <p class="ig-card__likes">2,067 likes</p>
        <p class="ig-card__caption">
          <strong>@jordan.park</strong>
          Hard water used to wreck my scalp. A month in and soap rinses cleaner. Worth it.
        </p>
        <p class="ig-card__time">2 WEEKS AGO</p>
      </div>
    </article>

    <article class="ig-card">
      <header class="ig-card__head">
        {{ 'avatar-avery.jpg' | asset_url | img_tag: 'Avery Lopez', 'ig-card__avatar' }}
        <div class="ig-card__meta">
          <strong>@averylopez</strong>
          <span>Chicago, IL</span>
