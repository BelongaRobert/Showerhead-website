        {{ 'ugc-avery.jpg' | asset_url | img_tag: 'Unboxing Dr. Droppy shower head', '' }}
      </div>
      <div class="ig-card__body">
        <div class="ig-card__actions" aria-hidden="true"><span>♡</span><span>💬</span><span>➤</span></div>
        <p class="ig-card__likes">2,540 likes</p>
        <p class="ig-card__caption">
          <strong>@averylopez</strong>
          Unboxed my Dr. Droppy head today. Looks premium and the droplet logo is so cute. Can’t wait for softer water.
        </p>
        <p class="ig-card__time">3 DAYS AGO</p>
      </div>
    </article>

    <article class="ig-card">
      <header class="ig-card__head">
        {{ 'avatar-chris.jpg' | asset_url | img_tag: 'Chris Miller', 'ig-card__avatar' }}
        <div class="ig-card__meta">
          <strong>@chrismiller</strong>
          <span>Phoenix, AZ</span>
        </div>
        <span class="ig-card__platform" aria-hidden="true">●●●</span>
      </header>
      <div class="ig-card__media">
        {{ 'ugc-chris.jpg' | asset_url | img_tag: 'Installed Dr. Droppy shower head', '' }}
      </div>
      <div class="ig-card__body">
        <div class="ig-card__actions" aria-hidden="true"><span>♡</span><span>💬</span><span>➤</span></div>
        <p class="ig-card__likes">1,629 likes</p>
        <p class="ig-card__caption">
          <strong>@chrismiller</strong>
          Installed in minutes and the spray feels strong. Already noticing less dryness after showers.
        </p>
        <p class="ig-card__time">6 DAYS AGO</p>
      </div>
    </article>
  </div>
</section>

{% schema %}
{
  "name": "Social reviews",
  "settings": [
    { "type": "text", "id": "pill", "label": "Pill", "default": "Social proof" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real showers. Real reviews." },
    { "type": "text", "id": "rating_label", "label": "Rating label", "default": "4.9 · 128 Reviews" }
  ],
  "presets": [{ "name": "Social reviews" }]
}
{% endschema %}
