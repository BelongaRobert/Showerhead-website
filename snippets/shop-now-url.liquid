{%- comment -%}
  Shared product URL for every Shop / Shop now CTA.
  Priority:
  1) optional product argument
  2) theme setting featured_product
  3) first catalog product
  4) all products collection
{%- endcomment -%}
{%- if product != blank -%}
  {{- product.url -}}
{%- elsif settings.featured_product != blank -%}
  {{- settings.featured_product.url -}}
{%- elsif collections.all.products.first != blank -%}
  {{- collections.all.products.first.url -}}
{%- else -%}
  {{- routes.all_products_collection_url -}}
{%- endif -%}
